# Postgres connection string (Neon). Leave unset to use the embedded PGlite database in .data/pglite.
DATABASE_URL=
# Time zone for rendered times. Default Pacific.
NEXT_PUBLIC_DISPLAY_TZ=America/Los_Angeles
# Featured club (HockeyTech team id and code). Default San Jose Barracuda.
FEATURED_TEAM_ID=405
FEATURED_TEAM_ABBREV=SJ
# Feed key. Defaults to the one the AHL's public stats widget serves; set this if it rotates.
HOCKEYTECH_KEY=
